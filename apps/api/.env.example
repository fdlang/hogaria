# PostgreSQL connection (never commit the real .env file)
DATABASE_URL=postgresql://reformapro:reformapro_dev_password@localhost:5432/reformapro
HMAC_SECRET=replace_this_with_a_random_secret_of_at_least_32_characters
SIGNATURE_HMAC_SECRET=use_a_different_random_secret_of_at_least_32_characters
SIGNATURE_HMAC_KEY_ID=sig-2026-09
# JSON keyring retained only while historical v3 signatures require it.
SIGNATURE_HMAC_PREVIOUS_KEYS={}
# Optional: old, dedicated signature key only while v2 seals still exist.
SIGNATURE_HMAC_LEGACY_V2_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# Files and transactional email (required when these features are enabled)
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Hogaria <info@hogaria.design>
APP_URL=http://localhost:5173

# Account-change notices: migrate first; use an HTTPS APP_URL when enabled.
CLIENT_NOTIFICATIONS_ENABLED=false
# Set a random secret of at least 32 bytes for protected scheduled retries.
CRON_SECRET=
NOTIFICATION_RETRY_SECRET=

# Initial administrator. Change these values before any non-local deployment.
SEED_ADMIN_EMAIL=admin@reformapro.local
SEED_ADMIN_PASSWORD=ChangeMe_123!
SEED_ADMIN_NAME=Administrador ReformaPro
