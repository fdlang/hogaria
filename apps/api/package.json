{
  "name": "@reformapro/api",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/main.ts",
    "build": "tsc",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env ./scripts/migrate.mjs",
    "notifications:queue": "node --env-file=.env ./scripts/notification-queue.mjs",
    "db:migrate-client-notifications": "node --env-file=.env ./scripts/migrate-client-notifications.mjs",
    "db:reset-all": "node --env-file=.env ./scripts/reset-all.mjs",
    "db:migrate-sales-signature": "node --env-file=.env ./scripts/migrate-sales-signature.mjs",
    "db:migrate-estimate-rejection": "node --env-file=.env ./scripts/migrate-estimate-rejection.mjs",
    "db:migrate-account-activation": "node --env-file=.env ./scripts/migrate-account-activation.mjs",
    "db:migrate-rate-limits": "node --env-file=.env ./scripts/migrate-rate-limits.mjs",
    "db:migrate-work-tracking": "node --env-file=.env ./scripts/migrate-work-tracking.mjs",
    "db:migrate-catalog": "node --env-file=.env ./scripts/migrate-catalog.mjs",
    "db:seed-catalog": "tsx --env-file=.env ./scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@reformapro/domain": "*",
    "@types/pg": "^8.23.1",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
