{
  "name": "@reformapro/api",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/main.ts",
    "build": "tsc",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "preflight:production": "node --env-file=.env ./scripts/preflight-production.mjs",
    "preflight:database": "node --env-file=.env ./scripts/preflight-production.mjs --database-only --legacy-v2-session-key",
    "db:migrate": "node --env-file=.env ./scripts/migrate.mjs",
    "notifications:queue": "node --env-file=.env ./scripts/notification-queue.mjs",
    "notifications:deadletters": "node --env-file=.env ./scripts/notification-deadletters.mjs",
    "db:reset-all": "node --env-file=.env ./scripts/reset-all.mjs",
    "db:seed-catalog": "tsx --env-file=.env ./scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@reformapro/domain": "*",
    "@types/pg": "^8.23.1",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
