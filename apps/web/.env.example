# EmailJS uses a browser-safe public key. Never put private email credentials here.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Build-time switch. Set to true and redeploy without pausing the Vercel project.
VITE_MAINTENANCE_MODE=false
